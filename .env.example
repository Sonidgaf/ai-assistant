# Токен от @BotFather
BOT_TOKEN=
# Ключ OpenRouter (https://openrouter.ai/keys)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4.5
# Локально SQLite, на сервере PostgreSQL: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///bot.db
FREE_REQUESTS=10
# Telegram ID админов через запятую (для /stats)
ADMIN_IDS=
# Сервисный ключ VK-приложения (dev.vk.com), нужен для анализа VK-сообществ. Можно оставить пустым.
VK_TOKEN=
# Поиск свежей информации в интернете (OpenRouter web plugin, около 0.02 $ за запрос): true / false
WEB_SEARCH=true
